<Project>
  <Import Project="../sdk/Nobirds.OldenEra.Modding.Sdk/Sdk/Sdk.props" />

  <PropertyGroup>
    <AssemblyName>OldenEraVisited</AssemblyName>
    <RootNamespace>Nobirds.OldenEra.Modding.Visited</RootNamespace>
    <ModId>nobirds.oldenera.visited</ModId>
    <ModName>Olden Era Visited</ModName>
    <Version>0.36.1</Version>
    <ModTags>ui;map;tooltip;info;buildings</ModTags>
    <ModRequires>nobirds.oldenera.core</ModRequires>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's obfuscated classes under names of their own (mod-common\shared\GameTypes.g.cs): this plugin works on the
         game's code itself, with the library's internal names (InternalsVisibleTo), and is built for one game version. -->
    <Compile Include="..\mod-common\shared\GameTypes.g.cs" Link="shared\GameTypes.g.cs" />
  </ItemGroup>

  <Import Project="../sdk/Nobirds.OldenEra.Modding.Sdk/Sdk/Sdk.targets" />
</Project>
