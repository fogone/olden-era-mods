<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes prefabs of the game's kind into a mod's AssetBundle (#62): from a model prefab of the bundle (an animated
       skinned mesh) the battle and the map prefabs of a unit, with the game's components by readable names
       (OldenEra.UnitViewHelper...; the library puts the running game's names in). Elsewhere it is the dotnet tool
       Nobirds.OldenEra.Modding.Bundle (command oe-bundle):
         dotnet pack tools\bundle -c Release   -> bin\Release\Nobirds.OldenEra.Modding.Bundle.<version>.nupkg -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bundle</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oe-bundle</ToolCommandName>
    <PackageId>Nobirds.OldenEra.Modding.Bundle</PackageId>
    <Version>0.1.0</Version>
    <Authors>fogone</Authors>
    <Description>Writes prefabs of the game's kind (a unit's battle and map prefabs) into a mod's AssetBundle for Heroes of Might and Magic: Olden Era mods made with Nobirds.OldenEra.Modding.Sdk. Not affiliated with the game's publishers.</Description>
    <PackageTags>olden-era;heroes;bepinex;mod;assetbundle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fogone/olden-era-mods</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
  </ItemGroup>
</Project>
