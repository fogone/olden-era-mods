<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the mod manager's file logic (the update and its rollback) on temporary folders: no BepInEx, no game.
       Run: dotnet run, project tools/manager-tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\mod-manager\shared\*.cs" Link="shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
