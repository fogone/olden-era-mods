<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the mod manager's file logic (the update and its rollback) and of the library's data additions on
       temporary folders: no BepInEx, no game.
       Run: dotnet run, project tools/manager-tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\mod-manager\shared\*.cs" Link="shared\%(Filename)%(Extension)" />
    <!-- The library's additions to the game's single-object files: plain JSON and zip work (its log in GameLog.cs). -->
    <Compile Include="..\..\mod-common\shared\DataAdditions.cs" Link="shared\DataAdditions.cs" />
    <Compile Include="..\..\mod-common\shared\DataCopies.cs" Link="shared\DataCopies.cs" />
  </ItemGroup>
</Project>
